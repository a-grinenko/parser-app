{
  "name": "andrii/st-app",
  "type": "project",
  "require": {
    "php": "^8.4",
    "symfony/console": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/config": "^8.0",
    "symfony/yaml": "^8.0"
  },
  "config": {
    "platform": {
      "php": "8.4"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Common\\": "common/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.93"
  }
}
